# 统一换行符：源码与脚本用 LF，避免 Windows 上 checkout 后
# 把 .sh 改成 CRLF 导致在 Linux 上执行报 "$'\r': command not found"。
* text=auto eol=lf

*.sh text eol=lf
*.toml text eol=lf
*.service text eol=lf
*.rs text eol=lf
*.dart text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.ico binary
*.so binary
*.dll binary
*.jar binary
*.zip binary
