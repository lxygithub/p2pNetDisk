[Unit]
Description=iroh relay server (self-hosted, P0-pre)
Documentation=https://github.com/n0-computer/iroh/tree/main/iroh-relay
After=network-online.target
Wants=network-online.target

# 关键加固：配置文件缺失时直接让服务启动失败。
# 因为 iroh-relay 的 Config::load() 在文件不存在时会静默回退到
# plain HTTP :80 / 无 TLS / access=everyone，不会报错，非常危险。
AssertPathExists=/etc/iroh/relay.toml

[Service]
Type=simple
User=iroh-relay
Group=iroh-relay

# 二进制由 `cargo build --profile optimized-release --package iroh-relay --features server`
# 产出后安装到此处。CLI 参数是 --config-path / -c，不是上游 docker/README.md 里写的 --config。
ExecStart=/usr/local/bin/iroh-relay --config-path /etc/iroh/relay.toml

WorkingDirectory=/var/lib/iroh-relay
StateDirectory=iroh-relay
StateDirectoryMode=0700

Environment=RUST_LOG=info

Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

# 绑定 80/443 特权端口但不以 root 运行。
# 若发行版不支持 AmbientCapabilities，改用：setcap 'cap_net_bind_service=+ep' /usr/local/bin/iroh-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# 最小权限：文件系统默认只读，仅证书/状态目录可写。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/iroh-relay

# 注意：不要在此设置 IROH_RELAY_ACCESS_TOKEN。
# 该环境变量会覆盖 relay.toml 里 access.shared_token 的整个列表为单个 token。

[Install]
WantedBy=multi-user.target
